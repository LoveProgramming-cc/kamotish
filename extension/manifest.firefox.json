{
  "manifest_version": 3,
  "name": "卡谋语渲染 (Kamotish)",
  "version": "1.0.0",
  "description": "把网页里任意文字中的 \\kamotish{...} 渲染成卡谋语文字。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "卡谋语渲染",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "kamotish.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kamotish@kamotish.local",
      "strict_min_version": "115.0"
    }
  }
}